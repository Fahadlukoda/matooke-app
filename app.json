{
  "expo": {
    "name": "Team Matooke",
    "slug": "matooke-app",
    "experiments": {
      "baseUrl": "/matooke-app"
    },
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "matooke",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F7EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ug.co.teammatooke.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Team Matooke uses your location to track your runs and show your route.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Team Matooke records your route in the background so your run is saved even when the screen is off.",
        "NSMotionUsageDescription": "Team Matooke counts your steps during runs.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "ug.co.teammatooke.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#F5F7EE"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "ACTIVITY_RECOGNITION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 35
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b3a20468-9d75-466b-a07f-b162afd88282"
      }
    }
  }
}
